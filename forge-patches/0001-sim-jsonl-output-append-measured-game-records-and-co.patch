+    public static final class DamageThroughFive {
+        private final Game game;
+        private final int[] totals;
+
+        DamageThroughFive(Game game) {
+            this.game = game;
+            totals = new int[game.getRegisteredPlayers().size()];
+        }
+
+        @Subscribe
+        public void onDamage(GameEventPlayerDamaged event) {
+            // Round five means the first ten global turns; extra turns consume this same budget.
+            if (game.getPhaseHandler().getTurn() <= 10) {
+                for (int seat = 0; seat < totals.length; seat++) {
+                    var player = game.getRegisteredPlayers().get(seat).getView();
+                    if (player.equals(event.source().getController()) && !player.equals(event.target())) {
+                        totals[seat] += event.amount();
+                    }
+                }
+            }
+        }
+    }
