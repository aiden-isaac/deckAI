From 31a6f7eabe78499edd81b17507e94c7dba1e4302 Mon Sep 17 00:00:00 2001
From: aiden-isaac <aidenisaac08@gmail.com>
Date: Fri, 20 Nov 2026 23:34:59 +0800
Subject: [PATCH 2/2] sim-per-game-seed: reseed each independent game from a
 seed file

---
 .../main/java/forge/view/SimulateMatch.java   | 35 +++++++++++++++++--
 1 file changed, 32 insertions(+), 3 deletions(-)

diff --git a/forge-gui-desktop/src/main/java/forge/view/SimulateMatch.java b/forge-gui-desktop/src/main/java/forge/view/SimulateMatch.java
index 07666097..6d1e9c19 100644
--- a/forge-gui-desktop/src/main/java/forge/view/SimulateMatch.java
+++ b/forge-gui-desktop/src/main/java/forge/view/SimulateMatch.java
@@ -134,6 +134,24 @@ public class SimulateMatch {
             MyRandom.setRandom(new Random(seed));
         }
 
+        List<Long> perGameSeeds = null;
+        if (params.containsKey("S")) {
+            if (params.containsKey("s") || params.containsKey("t")) {
+                throw new IllegalArgumentException("-S cannot be combined with -s or -t");
+            }
+            try {
+                perGameSeeds = new ArrayList<>();
+                for (String line : Files.readAllLines(Path.of(params.get("S").get(0)), StandardCharsets.UTF_8)) {
+                    perGameSeeds.add(Long.parseLong(line.trim()));
+                }
+            } catch (IOException e) {
+                throw new UncheckedIOException("Cannot read seed file", e);
+            }
+            if (perGameSeeds.isEmpty() || (matchSize == 0 && perGameSeeds.size() != nGames)) {
+                throw new IllegalArgumentException("Seed file must contain exactly -n signed 64-bit integers, one per line");
+            }
+        }
+
         Path output = params.containsKey("o") ? Path.of(params.get("o").get(0)) : null;
         Integer firstSeat = params.containsKey("first") ? Integer.valueOf(params.get("first").get(0)) : null;
         if (firstSeat != null && (firstSeat < 0 || firstSeat > 1)) {
@@ -231,14 +249,14 @@ public class SimulateMatch {
             int iGame = 0;
             while (!mc.isMatchOver()) {
                 // play games until the match ends
-                simulateSingleMatch(mc, iGame, outputGamelog, output, output == null ? null : gameSeeds.nextLong(), firstSeat, iGame + 1);
+                simulateSingleMatch(mc, iGame, outputGamelog, output, gameSeed(perGameSeeds, gameSeeds, output, iGame), firstSeat, iGame + 1);
                 iGame++;
             }
         } else {
             for (int iGame = 0; iGame < nGames; iGame++) {
                 // Each measured BO1 starts with fresh match history, including the play/draw decision.
-                Match single = output == null ? mc : new Match(rules, pp, "Test");
-                simulateSingleMatch(single, iGame, outputGamelog, output, output == null ? null : gameSeeds.nextLong(), firstSeat, 1);
+                Match single = output == null && perGameSeeds == null ? mc : new Match(rules, pp, "Test");
+                simulateSingleMatch(single, iGame, outputGamelog, output, gameSeed(perGameSeeds, gameSeeds, output, iGame), firstSeat, 1);
             }
         }
 
@@ -248,6 +266,16 @@ public class SimulateMatch {
         System.out.flush();
     }
 
+    private static Long gameSeed(List<Long> seeds, Random generated, Path output, int index) {
+        if (seeds != null) {
+            if (index >= seeds.size()) {
+                throw new IllegalArgumentException("Seed file exhausted before the match ended");
+            }
+            return seeds.get(index);
+        }
+        return output == null ? null : generated.nextLong();
+    }
+
     private static void argumentHelp() {
         System.out.println("Syntax: forge.exe sim -d <deck1[.dck]> ... <deckX[.dck]> -D [D] -n [N] -m [M] -t [T] -p [P] -f [F] -s [S] -a [A] -mc [on|off] -q");
         System.out.println("\tsim - stands for simulation mode");
@@ -263,6 +291,7 @@ public class SimulateMatch {
         System.out.println("\tA - AI profile per player, in the same order as the decks (e.g. -a Default Experimental)");
         System.out.println("\tc - Clock flag. Set the maximum time in seconds before calling the match a draw, defaults to 120.");
         System.out.println("\tmc - Flat Monte Carlo AI refinement for this run, on, max or off (default off in simulations; max = desktop strength). Prints timing statistics at the end when on.");
+        System.out.println("\t-S FILE - one signed 64-bit seed per game; reseed before game creation (-s remains run-wide without -o)");
         System.out.println("\to FILE - append one JSON record per completed game (independent seeded BO1s with -n)");
         System.out.println("\tfirst 0|1 - force the starting seat independently of deck order");
         System.out.println("\tq - Quiet flag. Output just the game result, not the entire game log.");
-- 
